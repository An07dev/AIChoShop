DATABASE_URL="postgresql://postgres.mofjzncsduwrhteijudy:phanNHOBOXOAI123%40@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
# 2. OpenAI API Key (Dùng cho các tính năng AI: Viết SEO, Kịch bản TikTok, Kháng nghị vi phạm,...)
# Nếu chưa có Key thật, hệ thống sẽ tự động chuyển sang chế độ giả lập (demo mock data)
OPENAI_API_KEY=""

# 3. Supabase Config (Tùy chọn - nếu bạn muốn mở rộng Supabase Auth/Storage sau này)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Shared AI policy (0 disables generation at that scope)
AI_ENABLED=true
AI_VIP_DAILY_LIMIT=200
AI_GLOBAL_DAILY_ATTEMPTS=5000
# Separate local test database, never the production database
# TEST_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/aichoshop_test

# Password recovery via Resend; use a verified sender domain
RESEND_API_KEY=""
RECOVERY_EMAIL_FROM=""
APP_URL="http://localhost:3000"
