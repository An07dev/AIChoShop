# 1. Database Connection (PostgreSQL - Neon, Supabase, hoặc Local PostgreSQL)
# Ví dụ Local: postgresql://postgres:123456@localhost:5432/aichoshop?schema=public
# Ví dụ Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DATABASE_URL="postgresql://postgres:password@localhost:5432/aichoshop?schema=public"
# DATABASE_URL="postgresql://postgres:change-me@localhost:5432/aichoshop"
DATABASE_URL="postgresql://postgres:change-me@127.0.0.1:5432/aichoshop"
# 2. OpenAI API Key (Dùng cho các tính năng AI: Viết SEO, Kịch bản TikTok, Kháng nghị vi phạm,...)
# Nếu chưa có Key thật, hệ thống sẽ tự động chuyển sang chế độ giả lập (demo mock data)
OPENAI_API_KEY=""

# 3. Supabase Config (Tùy chọn - nếu bạn muốn mở rộng Supabase Auth/Storage sau này)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
# Server only. Never prefix this key with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="course-videos"
# Pro projects can set this above 50 MiB after increasing Storage global + bucket limits.
VIDEO_MAX_UPLOAD_MIB=500
VIDEO_SIGNED_URL_TTL_SECONDS=3600

# Shared AI policy (0 disables generation at that scope)
AI_ENABLED=true
AI_VIP_DAILY_LIMIT=200
AI_GLOBAL_DAILY_ATTEMPTS=5000
# Separate local test database, never the production database
# TEST_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/aichoshop_test

# Password recovery via Resend; use a verified sender domain
RESEND_API_KEY=""
RECOVERY_EMAIL_FROM=""
APP_URL="http://localhost:3000"

# Private persistent storage outside public/. Back up this directory with the database.
MEDIA_ROOT="D:/AIChoShop/.data/media"
