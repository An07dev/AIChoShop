{
  "name": "seller-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:auth": "node --test scripts/test-auth.cjs",
    "test:payments": "node --test scripts/test-payments.cjs && node --experimental-strip-types --test src/lib/payments/policy.test.ts",
    "test:payments:db": "node --test scripts/test-payments-db.cjs",
    "test:pricing": "node --experimental-strip-types --test src/lib/pricing/engine.test.ts",
    "test:pricing:full": "node --experimental-strip-types --test src/lib/pricing/engine.test.ts src/lib/pricing/csv.test.ts src/lib/pricing/fee-resolver.test.ts src/lib/koc-planner/engine.test.ts",
    "test:pricing:db": "node --test scripts/test-pricing-fees-db.cjs",
    "test:seo": "node --experimental-strip-types --test src/lib/seo/seo.test.ts",
    "test:seo:db": "node scripts/test-seo-db.cjs",
    "db:seo": "node scripts/setup-seo.cjs",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "test:ai:db": "node --test scripts/test-ai-quota-db.cjs",
    "test:media": "node --test scripts/test-media.cjs",
    "test:accounts:db": "node --test scripts/test-account-security-db.cjs",
    "test:recovery": "node --test scripts/test-recovery-mail.cjs",
    "test:recovery:db": "node --test scripts/test-recovery-db.cjs",
    "test:audit": "node --test scripts/test-audit.cjs",
    "test:audit:db": "node --test scripts/test-audit-db.cjs",
    "test:learning": "node --experimental-strip-types --test src/lib/learning/policy.test.ts src/lib/supabase-storage.test.ts && node --test scripts/test-media.cjs",
    "test:learning:db": "node --test scripts/test-learning-db.cjs",
    "migrate:videos:supabase": "node scripts/migrate-local-videos-to-supabase.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "@types/pg": "^8.23.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "openai": "^7.10.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tus-js-client": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
