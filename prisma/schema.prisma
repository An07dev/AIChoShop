// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String        // Mật khẩu đã mã hóa
  name         String?
  phone        String?
  role         Role          @default(USER)
  isVIP        Boolean       @default(false)
  vipExpiresAt DateTime?
  isLocked     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userCredit   UserCredit?
  transactions Transaction[]
  progress     Progress[]
}

enum Role {
  USER
  ADMIN
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  thumbnail   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]
}

model Lesson {
  id          String     @id @default(cuid())
  courseId    String
  course      Course     @relation(fields: [courseId], references: [id])
  title       String
  content     String?    @db.Text
  videoUrl    String?
  order       Int
  isVIP       Boolean    @default(false)
  moduleName  String     @default("Phần 1")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  progress    Progress[]
}


model Progress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

model Tool {
  id            String   @id @default(cuid())
  name          String
  description   String?
  type          String   // e.g., "SEO_DESC", "IMAGE_GEN"
  costInCredits Int      @default(0) // 0 means free
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UserCredit {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int      // Amount in VND or credits
  status    String   // PENDING, SUCCESS, FAILED
  type      String   // TOPUP, UPGRADE_VIP
  sepayId   String?  // Reference from SePay webhook
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PricingFeeOverride {
  id                 String    @id @default(cuid())
  platform           String
  shopType           String
  categoryId         String
  commissionRate     Float?
  transactionRate    Float?
  orderProcessingFee Int?
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  sourceName         String
  sourceUrl          String?
  note               String?   @db.Text
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([platform, shopType, categoryId, active])
}

model VipPlan {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  price         Int
  originalPrice Int
  period        String
  durationDays  Int?
  desc          String   @db.Text
  tag           String?
  isPopular     Boolean  @default(false)
  features      String[]
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, order])
}

model SePayConfig {
  id            String   @id @default("default")
  bankName      String   @default("MB Bank")
  accountNumber String   @default("0358888899")
  accountHolder String   @default("AIChoShop Official")
  apiKey        String?
  syntaxPrefix  String   @default("VIP")
  autoActivate  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
